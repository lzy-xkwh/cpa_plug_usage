{
  "schema_version": 2,
  "plugins": [
    {
      "id": "api-balance",
      "name": "供应商余额",
      "description": "自动查询各供应商与中转站余额并在 CPA 供应商页签展示：支持 DeepSeek、Kimi、OpenRouter、one-api / New API / sub2api 系站点；零配置自动识别、供应商列表与余额直读、可勾选显示名单、管理后台内置中文配置向导（官方无余额接口的供应商会明确标注）。",
      "author": "lzy-xkwh",
      "repository": "https://github.com/lzy-xkwh/cpa_plug_usage",
      "version": "0.9.0",
      "homepage": "https://github.com/lzy-xkwh/cpa_plug_usage",
      "license": "MIT",
      "tags": [
        "balance",
        "quota",
        "deepseek",
        "moonshot",
        "openrouter",
        "one-api",
        "new-api",
        "sub2api",
        "中文"
      ],
      "install": {
        "type": "direct",
        "artifacts": [
          {
            "goos": "linux",
            "goarch": "amd64",

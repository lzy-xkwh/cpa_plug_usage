            "sha256": "87a3f5e0336a934e6663480d8d190d8276e90e5e3c7c4a4c8e18bc80139d45d0"
          }
        ]
      },
      "logo": "https://cdn.jsdelivr.net/gh/lzy-xkwh/cpa_plug_usage@main/assets/logo.svg"
    }
  ]
}
